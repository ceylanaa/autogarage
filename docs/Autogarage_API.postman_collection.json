{
  "info": {
    "name": "Autogarage API - Abdullah Ceylan",
    "description": "Postman collectie voor de Autogarage web-API (NOVI Eindopdracht Backend). Start de applicatie, vul de variabele testWachtwoord in met het wachtwoord van de testgebruikers (zie README) en voer eerst de drie login-verzoeken uit de map 'Openbaar' uit. De tokens worden dan automatisch opgeslagen.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Openbaar (geen token nodig)",
      "description": "Deze endpoints zijn voor iedereen bereikbaar. Hiermee log je in en krijg je een JWT-token terug.",
      "item": [
        {
          "name": "Inloggen als kassamedewerker",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logt de testgebruiker 'kassamedewerker' in en geeft een JWT-token terug. Dit token stuur je bij alle andere verzoeken mee in de header Authorization: Bearer <token>. Het token is 24 uur geldig. In Postman wordt het token automatisch opgeslagen in de variabele token_kassamedewerker.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gebruikersnaam\": \"kassamedewerker\",\n  \"wachtwoord\": \"{{testWachtwoord}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// token opslaan zodat de andere verzoeken het kunnen gebruiken",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token_kassamedewerker', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
